,"        if n in df.columns:\n","            return n\n","    return None\n","\n","def gini(x):\n","    \"\"\"Gini coefficient (non-negative).\"\"\"\n","    x = np.asarray(x, dtype=float)\n","    x = x[np.isfinite(x)]\n","    if len(x) == 0:\n","        return np.nan\n","    if np.min(x) < 0:\n","        x = x - np.min(x)\n","    s = x.sum()\n","    if s == 0:\n","        return 0.0\n","    x = np.sort(x)\n","    n = len(x)\n","    cumx = np.cumsum(x)\n","    return (n + 1 - 2 * np.sum(cumx) / cumx[-1]) / n\n","\n","# -----------------------------\n","# 안전 캐스팅\n","# -----------------------------\n","num_cols_candidates = [\n","    \"total_posts\",\"source_diversity\",\"unique_sources\",\"avg_len\",\"avg_sentiment\",\n","    \"max_zscore\",\"ewma_slope\",\"days_to_peak\",\"max_similarity\",\"mean_similarity\",\n","    \"sent_score\",\"sent_ratio\",\"sent_per_100w\",\"punc_q\",\"entropy\",\"rep_kw_count\",\n","    \"rep_kw_total\",\"uniq_words\",\"avg_tok_len\",\"source_entropy_norm\",\"speed_intensity\"\n","]\n","for c in num_cols_candidates:\n","    if c in df.columns:\n","        df[c] = pd.to_numeric(df[c], errors=\"coerce\")\n","\n","# -----------------------------\n","# 파생변수(부족 시 계산)\n","# -----------------------------\n","# speed_intensity = total_posts / (days_to_peak + 1)\n","if \"speed_intensity\" not in df.columns:\n","    col_posts = pick(df, \"total_posts\")\n","    col_days  = pick(df, \"days_to_peak\")\n","    if col_posts and col_days:\n","        posts = pd.to_numeric(df[col_posts], errors=\"coerce\")\n","        days  = pd.to_numeric(df[col_days], errors=\"coerce\")\n","        df[\"speed_intensity\"] = posts / (days + 1)\n","    else:\n","        df[\"speed_intensity\"] = np.nan\n","\n","# source_entropy_norm이 없으면 source_diversity로 대체(집중이 유리 → 1 - z(diversity))\n","if \"source_entropy_norm\" not in df.columns:\n","    col_div = pick(df, \"source_diversity\") or pick(df, \"unique_sources\")\n","    if col_div:\n","        df[\"source_entropy_norm\"] = 1 - zscore(df[col_div])  # 집중일수록 ↑\n","    else:\n","        df[\"source_entropy_norm\"] = np.nan\n","\n","# -----------------------------\n","# 감성 통합\n","# -----------------------------\n","z_sent_score = zscore(df.get(\"sent_score\", 0))\n","z_sent_ratio = zscore(df.get(\"sent_ratio\", 0))\n","z_sent_per   = zscore(df.get(\"sent_per_100w\", 0))\n","sent_intensity = (z_sent_score + z_sent_ratio + z_sent_per) / 3.0\n","\n","# -----------------------------\n","# 4개 축 + 페널티\n","# -----------------------------\n","# Buzz: total_posts, max_zscore, sentiment_intensity, punc_q(가중 0.5)\n","z_posts = zscore(df.get(pick(df, \"total_posts\"), 0))\n","z_peak  = zscore(df.get(pick(df, \"max_zscore\"), 0))\n","z_puncq = zscore(df.get(\"punc_q\", 0))\n","Buzz = (z_posts + z_peak + sent_intensity + 0.5 * z_puncq) / 3.5\n","\n","# Focus: entropy, rep_kw_count, rep_kw_total, uniq_words(가중 0.3)\n","z_entropy = zscore(df.get(\"entropy\", 0))\n","z_repkw   = (zscore(df.get(\"rep_kw_count\", 0)) + zscore(df.get(\"rep_kw_total\", 0))) / 2.0\n","z_uniq    = zscore(df.get(\"uniq_words\", 0))\n","Focus = (0.5 * z_entropy + 0.5 * z_repkw + 0.3 * z_uniq) / 1.3\n","\n","# Depth: avg_tok_len, avg_len, sent_ratio, sent_per_100w\n","z_tok   = zscore(df.get(\"avg_tok_len\", 0))\n","z_len   = zscore(df.get(pick(df, \"avg_len\"), 0))\n","z_sr    = zscore(df.get(\"sent_ratio\", 0))\n","z_sp100 = zscore(df.get(\"sent_per_100w\", 0))\n","Depth = (z_tok + z_len + z_sr + z_sp100) / 4.0\n","\n","# Spread: source_entropy_norm, ewma_slope(>=0만), speed_intensity\n","z_src   = zscore(df.get(\"source_entropy_norm\", 0))\n","slope   = df.get(pick(df, \"ewma_slope\"), pd.Series([np.nan]*len(df)))\n","slope   = pd.to_numeric(slope, errors=\"coerce\").clip(lower=0)  # 하락은 0으로 바닥\n","z_slope = zscore(slope)\n","z_speed = zscore(df.get(\"speed_intensity\", 0))\n","Spread = (z_src + z_slope + z_speed) / 3.0\n","\n","# Penalty: 1/(days_to_peak + 1) → 반짝일수록↑ → 감점\n","col_days = pick(df, \"days_to_peak\")\n","if col_days:\n","    days = pd.to_numeric(df[col_days], errors=\"coerce\")\n","    short_fuse = 1 / (days + 1)\n","    Penalty = zscore(short_fuse)\n","else:\n","    Penalty = pd.Series(0, index=df.index, dtype=float)\n","\n","# -----------------------------\n","# 최종 점수 (가중합)\n","# -----------------------------\n","score = (\n","    0.30 * Buzz +\n","    0.25 * Focus +\n","    0.25 * Depth +\n","    0.20 * Spread -\n","    0.15 * Penalty\n",")\n","\n","# 0~1 & 0~100\n","score_min, score_max = np.nanmin(score), np.nanmax(score)\n","if np.isfinite(score_min) and np.isfinite(score_max) and score_max > score_min:\n","    score_01 = (score - score_min) / (score_max - score_min)\n","else:\n","    score_01 = (score - score_min)  # 상수열 방지용\n","df[\"importance_score\"] = score_01.clip(0, 1)                    # 0~1\n","df[\"law_demand_index\"] = (df[\"importance_score\"] * 100).round(2)  # 0~100\n","\n","# -----------------------------\n","# 저장 (메인 산출물)\n","# -----------------------------\n","df.to_csv(PATH_OUT_IMPORT, index=False, encoding=\"utf-8-sig\")\n","print(f\"✅ 중요도 저장 완료 → {PATH_OUT_IMPORT}\")\n","\n","# ======================================================\n","# ⬇️ 여기부터 시각화 & 통계 저장 (색상/라벨 = 2번 코드 기준)\n","# ======================================================\n","\n","# ====== English labels & pastel colors ======\n","law_map_en = {\n","    \"개인정보\": \"Personal Data\",\n","    \"정보통신\": \"Telecom\",\n","    \"아동복지\": \"Child Welfare\",\n","    \"자본\": \"Capital Market\"\n","}\n","color_map = {\n","    \"Personal Data\": \"#AEC7E8\",   # pastel blue\n","    \"Telecom\": \"#FF9999\",         # pastel red/pink\n","    \"Child Welfare\": \"#FFD966\",   # pastel yellow\n","    \"Capital Market\": \"#98DF8A\"   # pastel green\n","}\n","\n","# 라벨 맵핑\n","df[\"law_en\"] = df[\"law\"].map(law_map_en).fillna(df[\"law\"].astype(str))\n","\n","# 중요도 준비\n","viz = df.dropna(subset=[\"importance_score\", \"law_en\"]).copy()\n","viz[\"importance_score\"] = pd.to_numeric(viz[\"importance_score\"], errors=\"coerce\")\n","viz = viz.dropna(subset=[\"importance_score\"])\n","\n","# plotting 순서 고정\n","order = [\"Personal Data\", \"Telecom\", \"Child Welfare\", \"Capital Market\"]\n","order = [o for o in order if o in viz[\"law_en\"].unique()]\n","\n","# ====== 1) Boxplot (pastel) ======\n","data_by_law = [viz.loc[viz[\"law_en\"] == lg, \"importance_score\"].values for lg in order]\n","plt.figure(figsize=(8, 5))\n","bp = plt.boxplot(data_by_law, patch_artist=True, labels=order, showfliers=False)\n","for patch, lg in zip(bp['boxes'], order):\n","    patch.set_facecolor(color_map.get(lg, \"#cccccc\"))\n","    patch.set_alpha(0.85)\n","for whisker in bp['whiskers']:\n","    whisker.set_linestyle(\"-\")\n","plt.ylim(0, 1)\n","plt.title(\"Importance by Law (Boxplot)\")\n","plt.xlabel(\"Law\")\n","plt.ylabel(\"Importance (0–1)\")\n","plt.tight_layout()\n","plt.show()\n","\n","# ====== 2) Jittered scatter (pastel) ======\n","plt.figure(figsize=(8, 5))\n","for i, lg in enumerate(order, start=1):\n","    sub = viz.loc[viz[\"law_en\"] == lg, \"importance_score\"].values\n","    x = np.random.normal(loc=i, scale=0.06, size=len(sub))  # jitter\n","    plt.scatter(x, sub, alpha=0.6, s=18, color=color_map.get(lg, \"#cccccc\"), label=lg)\n","plt.xticks(range(1, len(order)+1), order)\n","plt.ylim(0, 1)\n","plt.title(\"Importance by Law (Jittered Scatter)\")\n","plt.xlabel(\"Law\")\n","plt.ylabel(\"Importance (0–1)\")\n","from matplotlib.patches import Patch\n","legend_patches = [Patch(color=color_map.get(lg, \"#cccccc\"), label=lg) for lg in order]\n","plt.legend(handles=legend_patches, title=\"Law\", loc=\"lower right\")\n","plt.tight_layout()\n","plt.show()\n","\n","# ====== 3) Scatter: total_posts vs importance ======\n","col_posts = pick(viz, \"total_posts\")\n","if col_posts is not None:\n","    plt.figure(figsize=(7.5, 5))\n","    for lg in order:\n","        sub = viz[viz[\"law_en\"] == lg]\n","        plt.scatter(sub[col_posts], sub[\"importance_score\"], alpha=0.6, s=16,\n","                    color=color_map.get(lg, \"#cccccc\"), label=lg)\n","    plt.title(\"Total Posts vs. Importance\")\n","    plt.xlabel(\"Total Posts\")\n","    plt.ylabel(\"Importance (0–1)\")\n","    plt.legend(title=\"Law\")\n","    plt.tight_layout()\n","    plt.show()\n","\n","# ====== 4) Scatter: max_zscore vs importance ======\n","col_z = pick(viz, \"max_zscore\")\n","if col_z is not None:\n","    plt.figure(figsize=(7.5, 5))\n","    for lg in order:\n","        sub = viz[viz[\"law_en\"] == lg]\n","        plt.scatter(sub[col_z], sub[\"importance_score\"], alpha=0.6, s=16,\n","                    color=color_map.get(lg, \"#cccccc\"), label=lg)\n","    plt.title(\"Max z-score vs. Importance\")\n","    plt.xlabel(\"Max z-score (daily count)\")\n","    plt.ylabel(\"Importance (0–1)\")\n","    plt.legend(title=\"Law\")\n","    plt.tight_layout()\n","    plt.show()\n","\n","# ====== 5) Top 10 topics overall (horizontal bar, pastel legend) ======\n","topic_col = \"topic_id\" if \"topic_id\" in viz.columns else None\n","topN = 10\n","top_df = viz.sort_values(\"importance_score\", ascending=False).head(topN).copy()\n","if topic_col:\n","    labels = [f\"Topic {int(t)}\" if str(t).isdigit() else f\"Topic {str(t)}\" for t in top_df[topic_col]]\n","else:\n","    labels = [f\"Row {i}\" for i in top_df.index]\n","bar_colors = [color_map.get(l, \"#cccccc\") for l in top_df[\"law_en\"]]\n","plt.figure(figsize=(8, 5.5))\n","y_pos = np.arange(len(top_df))[::-1]\n","plt.barh(y_pos, top_df[\"importance_score\"].values[::-1], color=bar_colors[::-1])\n","plt.yticks(y_pos, labels[::-1])\n","plt.xlabel(\"Importance (0–1)\")\n","plt.title(\"Top 10 Topics by Importance (Overall)\")\n","from matplotlib.patches import Patch\n","legend_elems = [Patch(facecolor=clr, label=lbl) for lbl, clr in color_map.items() if lbl in top_df[\"law_en\"].unique()]\n","if legend_elems:\n","    plt.legend(handles=legend_elems, title=\"Law\", loc=\"lower right\")\n","plt.tight_layout()\n","plt.show()\n","\n","# ======================================================\n","# 📦 기술통계 & 상관 & Top/Bottom 저장\n","# ======================================================\n","stats_df = viz.copy()\n","\n","# 전체 요약 통계\n","imp = stats_df[\"importance_score\"].dropna()\n","overall = imp.describe(percentiles=[0.1, 0.25, 0.5, 0.75, 0.9]).to_frame(name=\"importance_score\")\n","overall.loc[\"skew\"] = skew(imp, nan_policy=\"omit\")\n","overall.loc[\"kurtosis\"] = kurtosis(imp, nan_policy=\"omit\", fisher=True)\n","overall.loc[\"gini\"] = gini(imp)\n","for thr in [0.8, 0.9, 0.95]:\n","    overall.loc[f\"share_ge_{thr}\"] = (imp >= thr).mean()\n","overall_path = os.path.join(BASE_DIR, \"stats_overall_importance.csv\")\n","overall.to_csv(overall_path, encoding=\"utf-8-sig\")\n","print(\"✅ overall saved ->\", overall_path)\n","\n","# 법별 요약\n","rows = []\n","qs = [i/10 for i in range(0, 11)]\n","quant_rows = []\n","for law_g, sub in stats_df.groupby(\"law_en\", dropna=True):\n","    arr = sub[\"importance_score\"].dropna().values\n","    if len(arr) == 0:\n","        continue\n","    d = {\n","        \"law\": law_g,\n","        \"count\": len(arr),\n","        \"mean\": np.mean(arr),\n","        \"std\": np.std(arr, ddof=1) if len(arr) > 1 else np.nan,\n","        \"min\": np.min(arr),\n","        \"p10\": np.percentile(arr, 10),\n","        \"p25\": np.percentile(arr, 25),\n","        \"median\": np.median(arr),\n","        \"p75\": np.percentile(arr, 75),\n","        \"p90\": np.percentile(arr, 90),\n","        \"max\": np.max(arr),\n","        \"skew\": skew(arr) if len(arr) > 2 else np.nan,\n","        \"kurtosis\": kurtosis(arr, fisher=True) if len(arr) > 3 else np.nan,\n","        \"gini\": gini(arr),\n","        \"share_ge_0.8\": (arr >= 0.8).mean(),\n","        \"share_ge_0.9\": (arr >= 0.9).mean(),\n","        \"share_ge_0.95\": (arr >= 0.95).mean(),\n","    }\n","    rows.append(d)\n","    qvals = np.quantile(arr, qs)\n","    row_q = {\"law\": law_g}\n","    for q, v in zip(qs, qvals):\n","        row_q[f\"q{int(q*100)}\"] = v\n","    quant_rows.append(row_q)\n","\n","bylaw_df = pd.DataFrame(rows).sort_values(\"mean\", ascending=False)\n","bylaw_path = os.path.join(BASE_DIR, \"stats_by_law_importance.csv\")\n","bylaw_df.to_csv(bylaw_path, index=False, encoding=\"utf-8-sig\")\n","print(\"✅ by-law summary saved ->\", bylaw_path)\n","\n","quant_df = pd.DataFrame(quant_rows).sort_values(\"law\")\n","quant_path = os.path.join(BASE_DIR, \"stats_by_law_quantiles.csv\")\n","quant_df.to_csv(quant_path, index=False, encoding=\"utf-8-sig\")\n","print(\"✅ by-law quantiles saved ->\", quant_path)\n","\n","# 상관(피어슨/스피어만)\n","# 중요도 산출에 흔히 쓰는 피처 후보 자동 선택\n","feat_map = {\n","    \"total_posts\":      pick(stats_df, \"total_posts\"),\n","    \"source_diversity\": pick(stats_df, \"source_diversity\") or pick(stats_df, \"unique_sources\"),\n","    \"avg_len\":          pick(stats_df, \"avg_len\"),\n","    \"avg_sentiment\":    pick(stats_df, \"avg_sentiment\"),\n","    \"max_zscore\":       pick(stats_df, \"max_zscore\"),\n","    \"ewma_slope\":       pick(stats_df, \"ewma_slope\"),\n","    \"days_to_peak\":     pick(stats_df, \"days_to_peak\"),\n","    \"max_similarity\":   pick(stats_df, \"max_similarity\") or pick(stats_df, \"mean_similarity\"),\n","    \"entropy\":          \"entropy\" if \"entropy\" in stats_df.columns else None,\n","    \"rep_kw_count\":     \"rep_kw_count\" if \"rep_kw_count\" in stats_df.columns else None,\n","    \"rep_kw_total\":     \"rep_kw_total\" if \"rep_kw_total\" in stats_df.columns else None,\n","    \"uniq_words\":       \"uniq_words\" if \"uniq_words\" in stats_df.columns else None,\n","    \"avg_tok_len\":      \"avg_tok_len\" if \"avg_tok_len\" in stats_df.columns else None,\n","    \"punc_q\":           \"punc_q\" if \"punc_q\" in stats_df.columns else None,\n","    \"sent_ratio\":       \"sent_ratio\" if \"sent_ratio\" in stats_df.columns else None,\n","    \"sent_per_100w\":    \"sent_per_100w\" if \"sent_per_100w\" in stats_df.columns else None,\n","    \"speed_intensity\":  \"speed_intensity\" if \"speed_intensity\" in stats_df.columns else None,\n","    \"source_entropy_norm\": \"source_entropy_norm\" if \"source_entropy_norm\" in stats_df.columns else None,\n","}\n","feat_cols = [v for v in feat_map.values() if v is not None]\n","\n","for c in feat_cols:\n","    stats_df[c] = pd.to_numeric(stats_df[c], errors=\"coerce\")\n","\n","corr_cols = [\"importance_score\"] + feat_cols\n","corr_df = stats_df[corr_cols].copy()\n","corr_pearson = corr_df.corr(method=\"pearson\")\n","corr_spearman = corr_df.corr(method=\"spearman\")\n","\n","p_path = os.path.join(BASE_DIR, \"corr_pearson_importance_and_features.csv\")\n","s_path = os.path.join(BASE_DIR, \"corr_spearman_importance_and_features.csv\")\n","corr_pearson.to_csv(p_path, encoding=\"utf-8-sig\")\n","corr_spearman.to_csv(s_path, encoding=\"utf-8-sig\")\n","print(\"✅ correlations saved ->\", p_path, \" / \", s_path)\n","\n","# 법별 상관(중요도 vs 각 피처)\n","rows_corr = []\n","for law_g, sub in stats_df.groupby(\"law_en\", dropna=True):\n","    sub2 = sub[[\"importance_score\"] + feat_cols].dropna()\n","    if len(sub2) < 3:\n","        continue\n","    for fc in feat_cols:\n","        r_p = sub2[\"importance_score\"].corr(sub2[fc], method=\"pearson\")\n","        r_s = sub2[\"importance_score\"].corr(sub2[fc], method=\"spearman\")\n","        rows_corr.append({\"law\": law_g, \"feature\": fc, \"pearson\": r_p, \"spearman\": r_s})\n","bylaw_corr = pd.DataFrame(rows_corr).sort_values([\"law\", \"pearson\"], ascending=[True, False])\n","bylaw_corr_path = os.path.join(BASE_DIR, \"corr_by_law_importance_vs_features.csv\")\n","bylaw_corr.to_csv(bylaw_corr_path, index=False, encoding=\"utf-8-sig\")\n","print(\"✅ by-law correlations saved ->\", bylaw_corr_path)\n","\n","# 법별 Top/Bottom\n","topic_col = \"topic_id\" if \"topic_id\" in stats_df.columns else None\n","topk = 5\n","tops, bots = [], []\n","for law_g, sub in stats_df.group