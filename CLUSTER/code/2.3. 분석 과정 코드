.1,5.31,5.31,0,0,0,1,6.5,5.31,5.31,0,0,0,4.9,4.9,5.31,5.31,0,0,0,6.5,1,5.31,5.31,0,0,0,8.1,4.9,5.31,5.31,0,0,0,12,6.5,5.46,5.46,0,0,0,6.5,12Z\"/>\n","  </svg>\n","    </button>\n","    <script>\n","      (() => {\n","      const buttonEl =\n","        document.querySelector('#id_ab5044af-9617-42f1-bca6-0e387a499394 button.colab-df-generate');\n","      buttonEl.style.display =\n","        google.colab.kernel.accessAllowed ? 'block' : 'none';\n","\n","      buttonEl.onclick = () => {\n","        google.colab.notebook.generateWithVariable('alldf');\n","      }\n","      })();\n","    </script>\n","  </div>\n","\n","    </div>\n","  </div>\n"],"application/vnd.google.colaboratory.intrinsic+json":{"type":"dataframe","variable_name":"alldf"}},"metadata":{},"execution_count":5}]},{"cell_type":"markdown","source":["# (2) 입법예고 매칭 여부별 피처 차이 분석\n","\n","- 정규성 검정 후 자동으로 Welch t-test 또는 Mann–Whitney U test 수행\n","\n","- Cohen’s d (정규) 또는 Cliff’s delta (비정규)로 효과크기 산출\n","\n","- Benjamini–Hochberg FDR 보정으로 다중검정 오류 제어\n","\n","- Spearman 상관계수 기준, lawmake=1 vs 0 그룹별 상관 히트맵을 나란히 비교\n","\n","- 유의 변수 박스플롯 (시각적 비교)"],"metadata":{"id":"ZoK5lsLiJBmP"}},{"cell_type":"code","source":["# =========================================\n","# Lawmaking(=1) vs Not(=0) 분석 + 시각화 + Boxplots (ONE-STOP)\n","# =========================================\n","import numpy as np\n","import pandas as pd\n","from scipy import stats\n","import matplotlib.pyplot as plt\n","import math\n","\n","# --------- 0) 데이터 선택 ----------\n","df = alldf.copy()\n","# --------- 1) lawmake_bin 생성 (1=law make, else=0) ----------\n","df['lawmake_bin'] = (\n","    pd.to_numeric(df.get('lawmake', 0), errors='coerce')\n","      .fillna(0)\n","      .apply(lambda x: 1 if x == 1 else 0)\n",")\n","\n","# --------- 2) 수치형 컬럼 선택 (분석에서 제외할 열 정의) ----------\n","exclude_cols = {\n","    'topic_id', 'topic_text', 'opinion', 'lawmake', 'lawmake_bin',\n","    'rep_kw_top1', 'rep_kw_top3', 'peak_date', 'law', 'law_group',\n","    # 유사도류는 사용하지 않기로 했으므로 혹시 남아있어도 제외\n","    'similarity_score', 'mean_similarity', 'max_similarity'\n","}\n","num_cols = [c for c in df.select_dtypes(include=[np.number]).columns if c not in exclude_cols]\n","\n","# 분석용 프레임\n","df_num = df[num_cols + ['lawmake_bin']].copy()\n","g1 = df_num[df_num['lawmake_bin'] == 1].drop(columns=['lawmake_bin'])\n","g0 = df_num[df_num['lawmake_bin'] == 0].drop(columns=['lawmake_bin'])\n","\n","print(f\"[Info] group=1 rows: {len(g1)}, group=0 rows: {len(g0)}\")\n","\n","# --------- 3) 통계 검정 + 효과크기 + FDR 보정 ----------\n","def cohens_d(a, b):\n","    # Welch's d\n","    a, b = np.asarray(a), np.asarray(b)\n","    a = a[~np.isnan(a)]; b = b[~np.isnan(b)]\n","    if len(a) < 2 or len(b) < 2: return np.nan\n","    ma, mb = np.mean(a), np.mean(b)\n","    va, vb = np.var(a, ddof=1), np.var(b, ddof=1)\n","    sp = math.sqrt((va + vb) / 2.0)\n","    return np.nan if sp == 0 or np.isnan(sp) else (ma - mb) / sp\n","\n","def cliffs_delta(a, b):\n","    a, b = np.asarray(a), np.asarray(b)\n","    a = a[~np.isnan(a)]; b = b[~np.isnan(b)]\n","    if len(a) == 0 or len(b) == 0: return np.nan\n","    # small data → exact\n","    if len(a) * len(b) <= 2_000_000:\n","        gt = 0; lt = 0\n","        for x in a:\n","            gt += np.sum(x > b)\n","            lt += np.sum(x < b)\n","        return (gt - lt) / (len(a) * len(b))\n","    # large → sample\n","    rng = np.random.default_rng(42)\n","    aa = rng.choice(a, size=min(len(a), 5000), replace=False)\n","    bb = rng.choice(b, size=min(len(b), 5000), replace=False)\n","    gt = 0; lt = 0\n","    for x in aa:\n","        gt += np.sum(x > bb)\n","        lt += np.sum(x < bb)\n","    return (gt - lt) / (len(aa) * len(bb))\n","\n","results = []\n","for col in num_cols:\n","    x1 = g1[col].dropna().values\n","    x0 = g0[col].dropna().values\n","    if len(x1) < 3 or len(x0) < 3:\n","        continue\n","    try:\n","        # 정규성(표본 최대 5000)\n","        p1 = stats.shapiro(x1[:min(5000, len(x1))])[1] if len(x1) >= 3 else 0\n","        p0 = stats.shapiro(x0[:min(5000, len(x0))])[1] if len(x0) >= 3 else 0\n","\n","        if p1 > 0.05 and p0 > 0.05:\n","            stat, pval = stats.ttest_ind(x1, x0, equal_var=False, nan_policy='omit')\n","            test = \"Welch t-test\"\n","            eff = cohens_d(x1, x0); eff_name = \"Cohen's d\"\n","        else:\n","            stat, pval = stats.mannwhitneyu(x1, x0, alternative='two-sided')\n","            test = \"Mann–Whitney U\"\n","            eff = cliffs_delta(x1, x0); eff_name = \"Cliff's delta\"\n","\n","        results.append({\n","            'variable': col,\n","            'test': test,\n","            'mean(1)': np.mean(x1),\n","            'mean(0)': np.mean(x0),\n","            'diff(1-0)': np.mean(x1) - np.mean(x0),\n","            'effect_size': eff,\n","            'effect_name': eff_name,\n","            'p_value': pval\n","        })\n","    except Exception as e:\n","        print(f\"[Warn] {col}: {e}\")\n","\n","out = pd.DataFrame(results).sort_values('p_value') if results else pd.DataFrame()\n","if out.empty:\n","    print(\"[Warn] No tests were performed (insufficient data).\")\n","else:\n","    # Benjamini–Hochberg FDR 보정\n","    p = out['p_value'].values\n","    n = len(p)\n","    order = np.argsort(p)\n","    ranks = np.empty_like(order); ranks[order] = np.arange(1, n+1)\n","    q = p * n / ranks\n","    # monotone adjustment\n","    q_sorted = q[np.argsort(order)]\n","    q_monotone = np.minimum.accumulate(q_sorted[::-1])[::-1]\n","    out['p_fdr'] = q_monotone[np.argsort(np.argsort(order))]\n","\n","    print(\"\\n[Significant (FDR<0.05)]\")\n","    try:\n","        display(out.loc[out['p_fdr'] < 0.05].head(30))\n","    except:\n","        print(out.loc[out['p_fdr'] < 0.05].head(30).to_string(index=False))\n","\n","    print(\"\\n[Top-15 by raw p-value]\")\n","    try:\n","        display(out.head(15))\n","    except:\n","        print(out.head(15).to_string(index=False))\n","\n","# --------- 4) 상관 분석 (Spearman) ----------\n","def drop_allnan_cols(df_):\n","    keep = [c for c in df_.columns if df_[c].notna().sum() > 1]\n","    return df_[keep]\n","\n","# 그룹 별 공통 수치열\n","g1c = drop_allnan_cols(g1)\n","g0c = drop_allnan_cols(g0)\n","common_cols = sorted(list(set(g1c.columns) & set(g0c.columns)))\n","g1c = g1c[common_cols]\n","g0c = g0c[common_cols]\n","\n","corr1 = g1c.corr(method=\"spearman\") if not g1c.empty else pd.DataFrame()\n","corr0 = g0c.corr(method=\"spearman\") if not g0c.empty else pd.DataFrame()\n","\n","# 전체(all)\n","allc = drop_allnan_cols(df_num.drop(columns=['lawmake_bin']))\n","all_corr = allc.corr(method=\"spearman\") if not allc.empty else pd.DataFrame()\n","\n","# --------- 5) 히트맵 그리기 (영문, 순서: 1vs0 → All) ----------\n","def plot_heat(ax, mat, title):\n","    if mat.empty:\n","        ax.axis('off'); ax.set_title(title + \" (no data)\")\n","        return None\n","    im = ax.imshow(mat.values, vmin=-1, vmax=1, aspect=\"auto\")\n","    ax.set_title(title)\n","    ax.set_xticks(range(len(mat.columns))); ax.set_yticks(range(len(mat.index)))\n","    ax.set_xticklabels(mat.columns, rotation=90)\n","    ax.set_yticklabels(mat.index)\n","    return im\n","\n","# (A) 0 vs 1\n","fig, axes = plt.subplots(\n","    1, 2,\n","    figsize=(max(12, 0.5*len(common_cols)), max(6, 0.5*len(common_cols)))\n",")\n","im1 = plot_heat(axes[0], corr1, \"Correlation (lawmaking=1)\")\n","im2 = plot_heat(axes[1], corr0, \"Correlation (lawmaking=0)\")\n","if im1 is not None:\n","    cbar1 = fig.colorbar(im1, ax=axes[0], fraction=0.046, pad=0.04); cbar1.set_label(\"Spearman ρ\")\n","if im2 is not None:\n","    cbar2 = fig.colorbar(im2, ax=axes[1], fraction=0.046, pad=0.04); cbar2.set_label(\"Spearman ρ\")\n","plt.tight_layout(); plt.show()\n","\n","# (B) All\n","fig2, ax2 = plt.subplots(1, 1, figsize=(max(8, 0.5*len(all_corr.columns)), max(6, 0.5*len(all_corr.columns))))\n","im_all = plot_heat(ax2, all_corr, \"Correlation (All)\")\n","if im_all is not None:\n","    cbar_all = fig2.colorbar(im_all, ax=ax2, fraction=0.046, pad=0.04); cbar_all.set_label(\"Spearman ρ\")\n","plt.tight_layout(); plt.show()\n","\n","# --------- 6) 유의 변수 박스플롯 (1 vs 0, pastel colors) ----------\n","sig_vars = out.loc[out['p_fdr'] < 0.05, 'variable'].tolist() if not out.empty else []\n","if not sig_vars:\n","    print(\"[Info] No significant variables (FDR<0.05). Skipping boxplots.\")\n","else:\n","    # 박스플롯에 너무 많으면 상위 N만 (raw p-value 기준)\n","    TOPN = 12\n","    sig_order = out.loc[out['variable'].isin(sig_vars)].sort_values('p_value')['variable'].tolist()\n","    sel_vars = sig_order[:TOPN]\n","\n","    # 색상(파스텔톤)\n","    color0 = (0.95, 0.70, 0.75)  # pastel pink for lawmake=0\n","    color1 = (0.70, 0.85, 0.80)  # pastel green for lawmake=1\n","\n","    # 플롯 그리드\n","    n = len(sel_vars)\n","    ncols = 3\n","    nrows = math.ceil(n / ncols)\n","    fig, axes = plt.subplots(nrows, ncols, figsize=(ncols*5, nrows*4), squeeze=False)\n","    axes = axes.ravel()\n","\n","    for i, col in enumerate(sel_vars):\n","        ax = axes[i]\n","        data0 = df.loc[df['lawmake_bin']==0, col].dropna()\n","        data1 = df.loc[df['lawmake_bin']==1, col].dropna()\n","\n","        bp = ax.boxplot([data0, data1], patch_artist=True, widths=0.6,\n","                        labels=[\"lawmaking=0\", \"lawmaking=1\"])\n","        # 색 적용\n","        bp['boxes'][0].set_facecolor(color0); bp['boxes'][1].set_facecolor(color1)\n","        for med in bp['medians']: med.set_color('black')\n","        for whisk in bp['whiskers']: whisk.set_color('gray')\n","        for cap in bp['caps']: cap.set_color('gray')\n","\n","        ax.set_title(f\"{col} (p_fdr={float(out.loc[out['variable']==col,'p_fdr'].iloc[0]):.3g})\")\n","        ax.grid(True, axis='y', alpha=0.3)\n","\n","    # 남는 축 숨김\n","    for j in range(i+1, len(axes)):\n","        axes[j].axis('off')\n","\n","    plt.suptitle(\"Significant Variables (FDR<0.05): Boxplots by lawmaking group\", y=1.02, fontsize=14)\n","    plt.tight_layout()\n","    plt.show()\n","\n","# --------- 7) 상관 변화 큰 페어 요약 (선택) ----------\n","if not corr1.empty and not corr0.empty:\n","    cdiff = corr1 - corr0\n","    pairs = []\n","    cols = cdiff.columns\n","    for i in range(len(cols)):\n","        for j in range(i+1, len(cols)):\n","            a, b = cols[i], cols[j]\n","            pairs.append((a, b, cdiff.loc[a, b]))\n","    df_changes = pd.DataFrame(pairs, columns=[\"var1\", \"var2\", \"delta_rho\"]).sort_values(\"delta_rho\", ascending=False)\n","\n","    print(\"\\n[Top +Δρ in (1-0)]\")\n","    try: display(df_changes.head(15))\n","    except: print(df_changes.head(15).to_string(index=False))\n","\n","    print(\"\\n[Top -Δρ in (1-0)]\")\n","    try: display(df_changes.tail(15))\n","    except: print(df_changes.tail(15).to_string(index=False))\n","\n","    print(\"\\n[|Δρ| ≥ 0.20]\")\n","    big = df_changes.loc[df_changes['delta_rho'].abs() >= 0.20].sort_values(\"delta_rho\", key=lambda s: s.abs(), ascending=False)\n","    try: display(big.head(30))\n","    except: print(big.head(30).to_string(index=False))\n","else:\n","    print(\"\\n[Info] Skipped correlation-difference summary (insufficient data).\")\n"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":1000},"id":"VnUcEggT-kw-","executionInfo":{"status":"ok","timestamp":1760449716697,"user_tz":-540,"elapsed":3355,"user":{"displayName":"Yoon-Bin Cho","userId":"11300653913306801034"}},"outputId":"6d359e1d-f0dd-4f64-cc06-69497a7c825c"},"execution_count":null,"outputs":[{"output_type":"stream","name":"stdout","text":["[Info] group=1 rows: 47, group=0 rows: 234\n","\n","[Significant (FDR<0.05)]\n"]},{"output_type":"display_data","data":{"text/plain":["            variable            test        mean(1)       mean(0)  \\\n","26     avg_sentiment  Mann–Whitney U       8.856417     -1.961804   \n","3         sent_ratio  Mann–Whitney U       0.634546      0.445281   \n","18     sent_per_100w  Mann–Whitney U       0.303443     -1.109815