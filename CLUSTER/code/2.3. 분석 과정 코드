{"cells":[{"cell_type":"code","execution_count":null,"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"executionInfo":{"elapsed":23957,"status":"ok","timestamp":1760447919248,"user":{"displayName":"Yoon-Bin Cho","userId":"11300653913306801034"},"user_tz":-540},"id":"mDV_aduVa_D1","outputId":"8f70aa94-5e06-4e54-8af8-237edf896563"},"outputs":[{"output_type":"stream","name":"stdout","text":["Mounted at /content/drive\n"]}],"source":["from google.colab import drive\n","drive.mount('/content/drive')\n"]},{"cell_type":"markdown","source":["# (1) 피처 생성\n","\n","- KNU 감성사전 + 커스텀 사전 결합(1회)\n","\n","- 뉴스 원시파일 4개 → 뉴스 피처 생성(토크나이즈, 감성, 반복키워드 등)\n","\n","- 소셜 원시파일 3개(자본시장법 컬럼명 변이 자동 대응) → 토픽 단위 집계 생성\n","\n","- topic_id + law_group 기준으로 뉴스×소셜 병합\n","\n","- 입법 예고로 이어지면 lawmake = 1, 의견수(Opinion) 값 생성\n","\n","- 최종 결과만 CSV로 저장\n","\n"],"metadata":{"id":"IP0h5oQn1PVe"}},{"cell_type":"code","source":["# ===========================================\n","# 통합 파이프라인: 뉴스피처 + 소셜집계 + 최종병합 + 법안매칭(enrich)\n","# ===========================================\n","import os, re, math, subprocess\n","import numpy as np\n","import pandas as pd\n","from collections import Counter\n","from tqdm import tqdm\n","\n","# -------------------------------------------\n","# 0) 입출력 경로 셋업\n","# -------------------------------------------\n","NEWS_INPUT_FILES = [\n","    \"/content/drive/MyDrive/뉴스소셜텍스트/토픽모델링 - 매칭/매칭 결과물/topic_id_with_full_text(아동).csv\",\n","    \"/content/drive/MyDrive/뉴스소셜텍스트/토픽모델링 - 매칭/매칭 결과물/topic_id_with_full_text(자본).csv\",\n","    \"/content/drive/MyDrive/뉴스소셜텍스트/토픽모델링 - 매칭/매칭 결과물/개인정보보호법_topic_id34:2.csv\",\n","    \"/content/drive/MyDrive/뉴스소셜텍스트/토픽모델링 - 매칭/매칭 결과물/정통법_topic_id37:5.csv\",\n","]\n","\n","SOCIAL_INPUT_FILES = [\n","    \"/content/drive/MyDrive/뉴스소셜텍스트/10월9일 토픽에 소셜데이터 매칭/필터링된_결과_개인정보보호법_정보통신법_토픽매칭.csv\",\n","    \"/content/drive/MyDrive/뉴스소셜텍스트/10월9일 토픽에 소셜데이터 매칭/필터링된_결과__아동복지법_토픽매칭 .csv\",\n","    \"/content/drive/MyDrive/뉴스소셜텍스트/10월9일 토픽에 소셜데이터 매칭/필터링된_결과_자본시장법_토픽매칭.csv\",\n","]\n","\n","MATCH_PATH = \"/content/drive/MyDrive/뉴스소셜텍스트/(윤빈)1012/1과 매치된 법안(의견수까지).csv\"\n","\n","SAVE_DIR = \"/content/drive/MyDrive/뉴스소셜텍스트/(윤빈)1012\"\n","os.makedirs(SAVE_DIR, exist_ok=True)\n","FINAL_SAVE_PATH = os.path.join(SAVE_DIR, \"alldf_merged_enriched.csv\")  # ← 최종본(업데이트된 결과)\n","\n","# -------------------------------------------\n","# 1) KNU 감성사전 + 커스텀 사전 결합 (재사용 가능; 파일 우선)\n","# -------------------------------------------\n","import csv\n","\n","# KNU 사전 클론/로딩\n","if not os.path.exists(\"/content/KnuSentiLex\"):\n","    try:\n","        subprocess.run([\"git\",\"clone\",\"https://github.com/park1200656/KnuSentiLex.git\"], check=True)\n","    except Exception as e:\n","        print(\"⚠️ git clone 실패(이미 있거나 권한 문제일 수 있음):\", e)\n","\n","senti_path = \"/content/KnuSentiLex/SentiWord_Dict.txt\"\n","if not os.path.exists(senti_path):\n","    raise FileNotFoundError(\"KnuSentiLex 사전 파일을 찾을 수 없습니다.\")\n","\n","senti_df = pd.read_csv(senti_path, sep=\"\\t\", names=[\"word\",\"polarity\"], encoding=\"utf-8\")\n","senti_df.dropna(inplace=True)\n","senti_df[\"word\"] = senti_df[\"word\"].astype(str).str.strip()\n","\n","def _safe_float(x):\n","    try:\n","        return float(x)\n","    except Exception:\n","        try:\n","            return float(str(x).strip())\n","        except Exception:\n","            return 0.0\n","\n","senti_df[\"polarity\"] = senti_df[\"polarity\"].apply(_safe_float)\n","BASE_LEX = dict(zip(senti_df[\"word\"], senti_df[\"polarity\"]))\n","\n","# --- 커스텀 사전 (코드 내 기본값) ---\n","POS_LEX = {\n","    \"좋다\": 2.0, \"최고\": 2.5, \"훌륭\": 2.0, \"행복\": 2.3, \"추천\": 1.5, \"만족\": 1.8,\n","    \"즐거움\": 1.8, \"감사\": 1.7, \"괜찮\": 1.2, \"멋짐\": 2.0, \"사랑\": 2.5,\n","    \"꿀잼\": 2.4, \"디토\": 1.5, \"럭키비키\": 2.3, \"갓생\": 2.1, \"갓성비\": 2.0,\n","    \"레전드\": 2.8, \"국가권력급\": 2.6, \"킹정\": 2.1, \"인정\": 1.5, \"팩트\": 1.6,\n","    \"민주주의\": 2.2, \"투명성\": 1.8, \"개혁\": 2.0, \"혁신\": 2.1, \"발전\": 1.9, \"진보\": 1.7,\n","    \"통합\": 2.0, \"화합\": 2.2, \"협치\": 2.1, \"소통\": 1.9, \"개방\": 1.6, \"변화\": 1.8,\n","    \"공정\": 2.3, \"정의\": 2.4, \"평등\": 2.2, \"자유\": 2.5, \"인권\": 2.3, \"복지\": 2.0,\n","    \"평화\": 2.4, \"안전\": 2.1, \"안정\": 1.9, \"번영\": 2.2, \"성장\": 1.8, \"희망\": 2.3,\n","    \"개선\": 1.9, \"향상\": 1.8, \"보완\": 1.5, \"강화\": 1.7, \"확대\": 1.6, \"증진\": 1.7,\n","    \"찬성\": 2.1, \"지지\": 2.0, \"동의\": 1.8, \"공감\": 1.9, \"응원\": 2.0, \"격려\": 1.8,\n","    \"환영\": 2.2, \"축하\": 2.3, \"기대\": 1.9, \"신뢰\": 2.1, \"믿음\": 2.0, \"확신\": 1.9,\n","    \"합리성\": 2.0, \"타당성\": 1.9, \"필요성\": 1.7, \"중요성\": 1.8,\n","}\n","NEG_LEX = {\n","    \"나쁨\": -2.0, \"최악\": -2.5, \"실망\": -2.0, \"짜증\": -2.0, \"불만\": -1.8,\n","    \"혐오\": -2.3, \"반감\": -2.0, \"불편\": -1.6, \"분노\": -2.0,\n","    \"킹받음\": -2.2, \"노잼\": -2.1, \"현타\": -1.8, \"멘붕\": -1.9, \"억텐\": -1.5,\n","    \"독재\": -2.8, \"전제\": -2.6, \"독단\": -2.4, \"폭정\": -2.7, \"억압\": -2.5, \"탄압\": -2.6,\n","    \"부패\": -2.7, \"비리\": -2.5, \"부정\": -2.3, \"편법\": -2.2, \"불법\": -2.6, \"위법\": -2.4,\n","    \"사기\": -2.5, \"거짓\": -2.3, \"기만\": -2.4, \"조작\": -2.6, \"왜곡\": -2.2, \"은폐\": -2.4,\n","    \"무능\": -2.3, \"무책임\": -2.4, \"무관심\": -1.8, \"무시\": -2.1, \"방관\": -1.9, \"외면\": -1.8,\n","    \"갈등\": -2.2, \"분열\": -2.4, \"대립\": -2.1, \"충돌\": -2.3, \"마찰\": -1.9, \"반목\": -2.0,\n","    \"위기\": -2.4, \"혼란\": -2.2, \"불안\": -2.1, \"우려\": -1.8, \"걱정\": -1.7, \"염려\": -1.6,\n","    \"반대\": -2.1, \"거부\": -2.2, \"거절\": -2.0, \"비판\": -1.8, \"비난\": -2.3, \"성토\": -2.4, \"규탄\": -2.5,\n","    \"의혹\": -2.0, \"의심\": -1.9, \"불신\": -2.2, \"배신\": -2.4,\n","    \"실패\": -2.2, \"좌절\": -2.1, \"포기\": -1.9, \"철회\": -1.8, \"취소\": -1.7, \"중단\": -1.6,\n","    \"극좌\": -2.4, \"극우\": -2.4, \"종북\": -2.6, \"토착왜구\": -2.7, \"친일\": -2.5, \"매국\": -2.8,\n","    \"빨갱이\": -2.7, \"좌빨\": -2.6, \"수구\": -2.3, \"꼴통\": -2.4, \"수꼴\": -2.5, \"일베\": -2.2,\n","    \"개독\": -2.5, \"한남\": -2.3, \"페미\": -2.1, \"웜페\": -2.4, \"메갈\": -2.3, \"래디컬\": -2.2,\n","    \"극혐\": -2.8, \"개노답\": -2.3, \"쓰레기\": -2.4, \"헬조선\": -2.3,\n","    \"계엄\": -2.7, \"쿠데타\": -2.9, \"내란\": -2.8, \"반란\": -2.7, \"반역\": -2.8,\n","    \"스캔들\": -2.2, \"게이트\": -2.1,\n","}\n","DEFAULT_CUSTOM_LEX = {**POS_LEX, **NEG_LEX}\n","\n","# 저장/재사용 경로\n","CUSTOM_LEX_PATH = os.path.join(SAVE_DIR, \"custom_lexicon.tsv\")\n","MERGED_LEX_PATH = os.path.join(SAVE_DIR, \"merged_lexicon.tsv\")\n","\n","def load_lex_tsv(path) -> dict:\n","    d = {}\n","    with open(path, \"r\", encoding=\"utf-8\") as f:\n","        r = csv.reader(f, delimiter=\"\\t\")\n","        for row in r:\n","            if not row: continue\n","            w = str(row[0]).strip()\n","            if not w: continue\n","            try:\n","                sc = float(row[1])\n","            except Exception:\n","                sc = _safe_float(row[1])\n","            d[w] = sc\n","    return d\n","\n","def save_lex_tsv(path, lex: dict):\n","    with open(path, \"w\", encoding=\"utf-8\", newline=\"\") as f:\n","        w = csv.writer(f, delimiter=\"\\t\")\n","        for k, v in sorted(lex.items()):\n","            w.writerow([k, v])\n","\n","# ① 커스텀 사전: 파일이 있으면 파일 → 없으면 코드 내 DEFAULT 사용\n","if os.path.exists(CUSTOM_LEX_PATH):\n","    print(f\"📥 커스텀 사전 불러옴: {CUSTOM_LEX_PATH}\")\n","    CUSTOM_LEX = load_lex_tsv(CUSTOM_LEX_PATH)\n","else:\n","    print(\"🧩 커스텀 사전: 코드 내 기본값 사용 → TSV로 저장\")\n","    CUSTOM_LEX = DEFAULT_CUSTOM_LEX\n","    os.makedirs(SAVE_DIR, exist_ok=True)\n","    save_lex_tsv(CUSTOM_LEX_PATH, CUSTOM_LEX)\n","\n","# ② 병합 (커스텀 우선)\n","def combine_lexicons(lib_dict, custom_dict, mode=\"priority_custom\"):\n","    out = lib_dict.copy()\n","    for w, sc in custom_dict.items():\n","        if w in out:\n","            if mode == \"priority_custom\":\n","                out[w] = sc\n","            elif mode == \"max_abs\":\n","                out[w] = sc if abs(sc) >= abs(out[w]) else out[w]\n","            elif mode == \"sum\":\n","                out[w] = float(out[w]) + float(sc)\n","            else:\n","                out[w] = sc\n","        else:\n","            out[w] = sc\n","    return out\n","\n","LEXICON = combine_lexicons(BASE_LEX, CUSTOM_LEX, mode=\"priority_custom\")\n","\n","# ③ 병합 결과도 저장(재현성)\n","save_lex_tsv(MERGED_LEX_PATH, LEXICON)\n","print(f\"💾 병합 사전 저장: {MERGED_LEX_PATH} (단어 수: {len(LEXICON):,})\")\n","\n","# ④ 점수 함수\n","def sentiment_score_tokens(tokens) -> float:\n","    if not tokens: return 0.0\n","    return float(sum(LEXICON.get(tok, 0.0) for tok in tokens))\n","\n","def sentiment_score_ws(text: str) -> float:\n","    if not isinstance(text, str): return 0.0\n","    return float(sum(LEXICON.get(tok, 0.0) for tok in text.split()))\n","\n","# -------------------------------------------\n","# 2) 토크나이저 (뉴스용; Okt 우선)\n","# -------------------------------------------\n","try:\n","    from konlpy.tag import Okt\n","    okt = Okt()\n","    def tokenize(text):\n","        if not isinstance(text, str) or not text.strip(): return []\n","        return [t for t in okt.morphs(text, stem=True) if t.strip()]\n","except Exception:\n","    def tokenize(text):\n","        if not isinstance(text, str) or not text.strip(): return []\n","        return re.findall(r\"[가-힣]+|[A-Za-z]+|\\d+\", text)\n","\n","# -------------------------------------------\n","# 3) 뉴스 피처 함수\n","# -------------------------------------------\n","def sentiment_features(tokens):\n","    if not tokens: return 0.0, 0, 0, 0.0\n","    scores = [LEXICON.get(t, 0.0) for t in tokens]\n","    score_sum = float(sum(scores))\n","    pos_cnt = int(sum(1 for s in scores if s > 0))\n","    neg_cnt = int(sum(1 for s in scores if s < 0))\n","    ratio = pos_cnt / (pos_cnt + neg_cnt + 1e-6)\n","    return score_sum, pos_cnt, neg_cnt, ratio\n","\n","def repetition_features(tokens, min_freq=2, topn=3):\n","    if not tokens: return 0, 0, \"\", 0, \"\", 0.0\n","    c = Counter(tokens)\n","    rep_items = [(w, f) for w, f in c.items() if f >= min_freq]\n","    rep_kw_count = len(rep_items)\n","    rep_kw_total = sum(max(f - 1, 0) for _, f in rep_items)\n","    top_items = sorted(c.items(), key=lambda x: (-x[1], x[0]))[:topn]\n","    rep_kw_top1 = top_items[0][0] if top_items else \"\"\n","    rep_kw_top1_freq = top_items[0][1] if top_items else 0\n","    rep_kw_top3 = \",\".join([w for w, _ in top_items]) if top_items else \"\"\n","    n = sum(c.values())\n","    probs = [f / n for f in c.values()]\n","    entropy = -sum(p * math.log(p + 1e-12) for p in probs) if n > 0 else 0.0\n","    return rep_kw_count, rep_kw_total, rep_kw_top1, rep_kw_top1_freq, rep_kw_top3, entropy\n","\n","def simple_text_features(text, tokens):\n","    if not isinstance(text, str): text = \"\"\n","    char_len = len(text); word_len = len(tokens)\n","    uniq_words = len(set(tokens)) if tokens else 0\n","    ttr = uniq_words / (word_len + 1e-6)\n","    avg_tok_len = np.mean([len(t) for t in tokens]) if tokens else 0\n","    num_cnt = sum(1 for t in tokens if t.isdigit())\n","    eng_cnt = sum(1 for t in tokens if re.fullmatch(r\"[A-Za-z]+\", t))\n","    num_ratio = num_cnt / (word_len + 1e-6)\n","    eng_ratio = eng_cnt / (word_len + 1e-6)\n","    q_count = text.count(\"?\"); exc_count = text.count(\"!\")\n","    c = Counter(tokens)\n","    rep_kw_density = sum(1 for f in c.values() if f >= 2) / (word_len + 1e-6)\n","    return {\n","        \"char_len\": char_len, \"word_len\": word_len, \"uniq_words\": uniq_words, \"ttr\": ttr,\n","        \"avg_tok_len\": avg_tok_len, \"num_ratio\": num_ratio, \"eng_ratio\": eng_ratio,\n","        \"punc_q\": q_count, \"punc_exc\": exc_count, \"rep_kw_density\": rep_kw_density,\n","    }\n","\n","def build_news_features(df_raw: pd.DataFrame) -> pd.DataFrame:\n","    df = df_raw.copy()\n","    if \"topic_text\" not in df.columns:\n","        cands = [c for c in df.columns if c.lower() in {\"topic_text\",\"text\",\"content\",\"full_text\",\"본문\"}]\n","        if not cands: raise KeyError(f\"'topic_text' 컬럼을 찾을 수 없음: {list(df.columns)}\")\n","        df = df.rename(columns={cands[0]: \"topic_text\"})\n","    if \"topic_id\" not in df.columns:\n","        df[\"topic_id\"] = np.arange(len(df))\n","    df[\"tokens\"] = df[\"topic_text\"].apply(tokenize)\n","\n","    sent = df[\"tokens\"].apply(sentiment_features)\n","    df[\"sent_score\"] = sent.apply(lambda x: x[0])\n","    df[\"sent_pos\"]   = sent.apply(lambda x: x[1])\n","    df[\"sent_neg\"]   = sent.apply(lambda x: x[2])\n","    df[\"sent_ratio\"] = sent.apply(lambda x: x[3])\n","\n","    rep = df[\"tokens\"].apply(lambda t: repetition_features(t, min_freq=2, topn=3))\n","    df[\"rep_kw_count\"]     = rep.apply(lambda x: x[0])\n","    df[\"rep_kw_total\"]     = rep.apply(lambda x: x[1])\n","    df[\"rep_kw_top1\"]      = rep.apply(lambda x: x[2])\n","    df[\"rep_kw_top1_freq\"] = rep.apply(lambda x: x[3])\n","    df[\"rep_kw_top3\"]      = rep.apply(lambda x: x[4])\n","    df[\"entropy\"]          = rep.apply(lambda x: x[5])\n","\n","    basic = df.apply(lambda r: simple_text_features(r[\"topic_text\"], r[\"tokens\"]),\n","                     axis=1, result_type=\"expand\")\n","    df = pd.concat([df, basic], axis=1)\n","    df[\"sent_per_100w\"] = df.apply(lambda r: 100 * r[\"sent_score\"] / (r[\"word_len\"] + 1e-6), axis=1)\n","    return df.drop(columns=[\"tokens\"])\n","\n","# -------------------------------------------\n","# 4) law / law_group 라벨링\n","# -------------------------------------------\n","def law_from_path(path: str) -> str:\n","    name = os.path.basename(path)\n","    if \"아동\" in name: return \"아동복지\"\n","    if \"자본\" in name: return \"자본\"\n","    if \"개인정보\" in name: return \"개인정보\"\n","    if \"정통법\" in name or \"정보통신\" in name: return \"정보통신\"\n","    return \"기타\"\n","\n","def law_to_group(law: str) -> str:\n","    return \"개인정보_정보통신\" if law in {\"개인정보\",\"정보통신\"} else law\n","\n","def social_group_from_path(path: str) -> str:\n","    name = os.path.basename(path)\n","    if \"개인정보\" in name and \"정보통신\" in name: return \"개인정보_정보통신\"\n","    if \"아동복지\" in name: return \"아동복지\"\n","    if \"자본\" in name: return \"자본\"\n","    return \"기타\"\n","\n","# -------------------------------------------\n","# 5) 소셜 표준화/집계\n","# -------------------------------------------\n","CANDIDATES = {\n","    \"매칭된_topic_id\": [\"매칭된_topic_id\",\"matched_topic_id\",\"topic_id\"],\n","    \"date\":            [\"date\",\"작성일시\",\"created_at\",\"datetime\"],\n","    \"source\":          [\"source\",\"platform\",\"origin\"],\n","    \"본문_clean\":      [\"본문_clean\",\"본문\",\"content_clean\",\"text_clean\",\"full_text\",\"fulltext\"],\n","    \"noun_text\":       [\"noun_text\",\"noun_tokens\",\"명사열\",\"명사_토큰\"],\n","    \"유사도_점수\":     [\"유사도_점수\",\"similarity_score\",\"sim_score\"],\n","}\n","\n","def normalize_columns(df: pd.DataFrame) -> pd.DataFrame:\n","    df = df.copy()\n","    rename_map = {}\n","    for std, cands in CANDIDATES.items():\n","        for c in cands:\n","            if c in df.columns:\n","                rename_map[c] = std; break\n","    df = df.rename(columns=rename_map)\n","    req = [\"매칭된_topic_id\",\"date\",\"source\",\"본문_clean\",\"noun_text\"]\n","    miss = [c for c in req if c not in df.columns]\n","    if miss: raise KeyError(f\"필수 컬럼 누락: {miss} / 실제: {list(df.columns)}\")\n","    return df\n","\n","def parse_datetime(series: pd.Series) -> pd.Series:\n","    s = series.astype(str)\n","    dt = pd.to_datetime(s, format=\"%Y.%m.%d.%H\", errors=\"coerce\")\n","    if dt.isna().all(): dt = pd.to_datetime(s, errors=\"coerce\")\n","    return dt\n","\n","def process_social_data(df: pd.DataFrame) -> pd.DataFrame:\n","    df = normalize_columns(df)\n","    df[\"datetime\"]  = parse_datetime(df[\"date\"])\n","    df = df.dropna(subset=[\"datetime\"]).copy()\n","    df[\"date_only\"] = df[\"datetime\"].dt.date\n","    df[\"hour\"]      = df[\"datetime\"].dt.hour\n","    df[\"weekday\"]   = df[\"datetime\"].dt.weekday\n","    df[\"is_weekend\"]= df[\"weekday\"] >= 5\n","    df[\"text_len\"]  = df[\"본문_clean\"].astype(str).apply(len)\n","    df[\"sentiment\"] = df[\"noun_text\"].astype(str).apply(sentiment_score_ws)\n","\n","    stats = []\n","    for topic, g in tqdm(df.groupby(\"매칭된_topic_id\"), desc=\"소셜 토픽 집계\"):\n","        daily = g.groupby(\"date_only\").size().rename(\"count\").to_frame()\n","        daily.index = pd.to_datetime(daily.index)\n","        daily = daily.asfreq(\"D\", fill_value=0)\n","        mu, sigma = daily[\"count\"].mean(), daily[\"count\"].std()\n","        daily[\"z_post\"] = (daily[\"count\"] - mu) / (sigma + 1e-6)\n","        daily[\"ewma_post\"] = daily[\"count\"].ewm(span=3, adjust=False).mean()\n","        ewma_slope = daily[\"ewma_post\"].diff().mean()\n","\n","        peak_date = daily[\"count\"].idxmax() if not daily.empty else pd.NaT\n","        first_date = daily.index.min() if not daily.empty else pd.NaT\n","        days_to_peak = int((peak_date - first_date).days) if pd.notna(peak_date) and pd.notna(first_date) else np.nan\n","        period_days = int((daily.index.max() - daily.index.min()).days) + 1 if not daily.empty else 0\n","\n","        stats.append({\n","            \"topic_id\":        int(topic),\n","            \"period_days\":     period_days,\n","            \"total_posts\":     int(len(g)),\n","            \"unique_sources\":  int(g[\"source\"].nunique()),\n","            \"source_diversity\": g[\"source\"].nunique() / (len(g) + 1e-6),\n","            \"avg_len\":         float(g[\"text_len\"].mean()),\n","            \"weekend_ratio\":   float(g[\"is_weekend\"].mean()),\n","            \"mode_hour\":       int(g[\"hour\"].mode()[0]) if not g[\"hour\"].mode().empty else np.nan,\n","            \"avg_sentiment\":   float(g[\"sentiment\"].mean()),\n","            \"max_zscore\":      float(daily[\"z_post\"].max()) if not daily.empty else np.nan,\n","            \"ewma_slope\":      float(ewma_slope) if not daily.empty else np.nan,\n","            \"days_to_peak\":    days_to_peak,\n","            \"peak_date\":       peak_date.date() if pd.notna(peak_date) else np.nan,\n","            \"mean_similarity\": float(g[\"유사도_점수\"].mean()) if \"유사도_점수\" in g.columns else np.nan,\n","            \"max_similarity\":  float(g[\"유사도_점수\"].max())  if \"유사도_점수\" in g.columns else np.nan,\n","        })\n","    return pd.DataFrame(stats)\n","\n","# -------------------------------------------\n","# 6) 뉴스: 파일별 처리 후 결합\n","# -------------------------------------------\n","news_dfs = []\n","for fp in NEWS_INPUT_FILES:\n","    raw = pd.read_csv(fp)\n","    feat = build_news_features(raw)\n","    law = law_from_path(fp)\n","    feat[\"law\"] = law\n","    feat[\"law_group\"] = law_to_group(law)\n","    news_dfs.append(feat)\n","news_all = pd.concat(news_dfs, ignore_index=True)\n","\n","# -------------------------------------------\n","# 7) 소셜: 파일별 집계 후 결합\n","# -------------------------------------------\n","social_dfs = []\n","for fp in SOCIAL_INPUT_FILES:\n","    soci_raw = pd.read_csv(fp)\n","    stats = process_social_data(soci_raw)\n","    stats[\"law_group\"] = social_group_from_path(fp)\n","    social_dfs.append(stats)\n","social_all = pd.concat(social_dfs, ignore_index=True)\n","\n","# -------------------------------------------\n","# 8) 뉴스×소셜 병합 (topic_id + law_group)\n","# -------------------------------------------\n","merge_keys = [\"topic_id\", \"law_group\"]\n","alldf = pd.merge(\n","    news_all, social_all, how=\"left\", on=merge_keys, suffixes=(\"_news\", \"_social\")\n",")\n","\n","# 9) (2번 코드) 법안 매칭 집계 → alldf에 곧바로 enrich\n","# -------------------------------------------\n","def norm_text(s):\n","    if pd.isna(s): return np.nan\n","    return \" \".join(str(s).strip().split())\n","\n","# 매칭 파일 로드 + 열명 표준화\n","match_df = pd.read_csv(MATCH_PATH, low_memory=False)\n","rename_map = {}\n","\n","if \"opinion\" not in match_df.columns:\n","    for cand in [\"opinion_count\", \"의견수\", \"의견_수\"]:\n","        if cand in match_df.columns:\n","            rename_map[cand] = \"opinion\"; break\n","if \"law\" not in match_df.columns:\n","    for cand in [\"법\", \"법안\", \"법률명\"]:\n","        if cand in match_df.columns:\n","            rename_map[cand] = \"law\"; break\n","if \"topic_id\" not in match_df.columns:\n","    for cand in [\"토픽ID\", \"토픽id\", \"topic\"]:\n","        if cand in match_df.columns:\n","            rename_map[cand] = \"topic_id\"; break\n","\n","if rename_map:\n","    match_df = match_df.rename(columns=rename_map)\n","\n","# ✅ similarity_score 열 완전히 무시 (있더라도 삭제)\n","if \"similarity_score\" in match_df.columns:\n","    match_df = match_df.drop(columns=[\"similarity_score\"])\n","\n","# 필수 열 점검 (opinion, law, topic_id만 남음)\n","need_df_cols = {\"topic_id\", \"law\", \"opinion\"}\n","missing = need_df_cols - set(match_df.columns)\n","if missing:\n","    raise ValueError(f\"[매칭 파일] 필요한 열이 없습니다: {missing}\")\n","\n","# 키 정규화/정수화\n","alldf[\"law_key\"]   = alldf[\"law\"].map(norm_text)\n","match_df[\"law_key\"]= match_df[\"law\"].map(norm_text)\n","for _df in (alldf, match_df):\n","    _df[\"topic_id\"] = pd.to_numeric(_df[\"topic_id\"], errors=\"coerce\").astype(\"Int64\")\n","\n","# ✅ opinion만 집계 (similarity_score 제외)\n","agg = (\n","    match_df.groupby([\"topic_id\",\"law_key\"], dropna=True, as_index=False)\n","            .agg(opinion=(\"opinion\",\"mean\"))\n",")\n","agg[\"lawmake\"] = 1  # 매칭 성공 플래그\n","\n","# alldf에 left join\n","alldf = alldf.merge(\n","    agg, how=\"left\",\n","    left_on=[\"topic_id\",\"law_key\"],\n","    right_on=[\"topic_id\",\"law_key\"]\n",")\n","alldf[\"lawmake\"] = alldf[\"lawmake\"].fillna(0).astype(int)\n","alldf = alldf.drop(columns=[\"law_key\"])\n","\n","# ✅ 기존 alldf 내 mean_similarity, max_similarity 제거\n","drop_cols = [c for c in [\"mean_similarity\", \"max_similarity\", \"similarity_score\"] if c in alldf.columns]\n","if drop_cols:\n","    alldf = alldf.drop(columns=drop_cols)\n","\n","# -------------------------------------------\n","# 10) 최종 저장\n","# -------------------------------------------\n","alldf.to_csv(FINAL_SAVE_PATH, index=False, encoding=\"utf-8-sig\")\n","\n","print(\"✅ 최종 통합+enrich 완료:\", alldf.shape)\n","print(\"💾 Saved ->\", FINAL_SAVE_PATH)\n","print(\"   - 매칭 성공(lawmake=1) 행 수:\", int(alldf[\"lawmake\"].sum()))\n","alldf"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":1000},"id":"eieYpRxUuUfz","executionInfo":{"status":"ok","timestamp":1760447977352,"user_tz":-540,"elapsed":25390,"user":{"displayName":"Yoon-Bin Cho","userId":"11300653913306801034"}},"outputId":"307d0da6-658a-4201-cd38-dc6bada89b70"},"execution_count":null,"outputs":[{"output_type":"stream","name":"stdout","text":["📥 커스텀 사전 불러옴: /content/drive/MyDrive/뉴스소셜텍스트/(윤빈)1012/custom_lexicon.tsv\n","💾 병합 사전 저장: /content/drive/MyDrive/뉴스소셜텍스트/(윤빈)1012/merged_lexicon.tsv (단어 수: 14,961)\n"]},{"output_type":"stream","name":"stderr","text":["소셜 토픽 집계: 100%|██████████| 111/111 [00:00<00:00, 332.36it/s]\n","소셜 토픽 집계: 100%|██████████| 36/36 [00:00<00:00, 363.22it/s]\n","소셜 토픽 집계: 100%|██████████| 121/121 [00:00<00:00, 354.65it/s]\n"]},{"output_type":"stream","name":"stdout","text":["✅ 최종 통합+enrich 완료: (281, 39)\n","💾 Saved -> /content/drive/MyDrive/뉴스소셜텍스트/(윤빈)1012/alldf_merged_enriched.csv\n","   - 매칭 성공(lawmake=1) 행 수: 47\n"]},{"output_type":"execute_result","data":{"text/plain":["     topic_id                                         topic_text  sent_score  \\\n","0           0  교사측, 공소사실 부인  법원 \"학생들 증언 명확…성적 수치심 유발\" 수업 중 고등...     -8570.0   \n","1           1  홈플러스, 또 무더기 폐점… 희망 무급휴직에 임원 급여 반납도   기업회생 절차를 ...      -312.7   \n","2           2  국민의힘 선거운동원이 여중생들에게 이준석 개혁신당 대선 후보가 TV토론에 언급해 논...      -988.3   \n","3           3  대다수 출연자가 미성년자인 보이그룹 오디션 프로에 시청자위 지적  “청소년보호책임자...      -949.5   \n","4           4  간호사 3명 불구속 송치 휴대전화 포렌식으로 학대 증거 확보 대구경찰청은 지난 4월...        -5.6   \n","..        ...                                                ...         ...   \n","276        49  윤석열 대통령 탄핵 반대 집회에 이른바 `가짜 경찰` 주장이 소셜미디어(SNS) 등...      -196.4   \n","277        50  그룹 방탄소년단(BTS) 멤버 뷔, 정국에 관한 허위 영상을 올린 유튜버 ‘탈덕수용...       -43.5   \n","278        51  [데일리안 = 조인영 